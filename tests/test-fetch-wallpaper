#!/usr/bin/env bash

set -euo pipefail

PROJECT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
TEST_TMP=$(mktemp -d)
trap 'rm -rf -- "$TEST_TMP"' EXIT

export PATH="$PROJECT_DIR/tests/mocks:$PATH"
export TEST_FIXTURE_DIR="$PROJECT_DIR/tests/fixtures"

use_case() {
  local name="$1"

  export XDG_CACHE_HOME="$TEST_TMP/$name/cache"
  export XDG_STATE_HOME="$TEST_TMP/$name/state"
  export TEST_APPLY_LOG="$TEST_TMP/$name/applied.log"
  unset TEST_BING_FIXTURE TEST_BING_OLDER_FIXTURE TEST_FAIL_OLDER_ARCHIVE TEST_FAIL_UHD \
    TEST_IMAGE_URL_LOG TEST_IMAGE_FIXTURE TEST_OFFLINE TEST_OVERSIZE_IMAGE
  mkdir -p "$(dirname "$TEST_APPLY_LOG")"
  : >"$TEST_APPLY_LOG"
}

fetch() {
  "$PROJECT_DIR/scripts/fetch-wallpaper" --provider bing --market en-US "$@"
}

use_case rotation

first=$(fetch)
jq -e '.provider == "bing" and .market == "en-US" and .applied == true' >/dev/null <<<"$first"
jq -e '.imageUrl | endswith("_UHD.jpg")' >/dev/null <<<"$first"
first_urlbase=$(jq -r '.urlbase' <<<"$first")
first_path=$(jq -r '.path' <<<"$first")
[[ -f $first_path ]]
[[ $(jq -r '.urlbase' "$XDG_STATE_HOME/omarchy/fresh-wallpaper/current.json") == "$first_urlbase" ]]

second=$(fetch)
second_urlbase=$(jq -r '.urlbase' <<<"$second")
[[ $second_urlbase != "$first_urlbase" ]]
[[ $(wc -l <"$TEST_APPLY_LOG") -eq 2 ]]

dry_run=$(fetch --no-apply)
jq -e '.applied == false' >/dev/null <<<"$dry_run"
[[ $(wc -l <"$TEST_APPLY_LOG") -eq 2 ]]

third=$(fetch)
third_urlbase=$(jq -r '.urlbase' <<<"$third")
[[ $third_urlbase != "$first_urlbase" && $third_urlbase != "$second_urlbase" ]]
[[ $(jq 'length' "$XDG_STATE_HOME/omarchy/fresh-wallpaper/history.json") -eq 3 ]]

fourth=$(fetch)
fourth_urlbase=$(jq -r '.urlbase' <<<"$fourth")
[[ $fourth_urlbase != "$third_urlbase" ]]
[[ $(wc -l <"$TEST_APPLY_LOG") -eq 4 ]]

if fetch --provider unknown >/dev/null 2>&1; then
  printf 'unsupported provider unexpectedly succeeded\n' >&2
  exit 1
fi

use_case single-image
export TEST_BING_FIXTURE=bing-single.json
only=$(fetch)
only_again=$(fetch)
[[ $(jq -r '.urlbase' <<<"$only") == "$(jq -r '.urlbase' <<<"$only_again")" ]]
[[ $(wc -l <"$TEST_APPLY_LOG") -eq 2 ]]

use_case full-passes
mkdir -p "$TEST_TMP/full-passes/bin"
cat >"$TEST_TMP/full-passes/bin/shuf" <<'SHUF'
#!/bin/sh
# Deterministic stand-in for `shuf -i 0-N -n 1`: TEST_SHUF_INDEX, capped at N.
max=${2#0-}
index=${TEST_SHUF_INDEX:-0}
[ "$index" -le "$max" ] || index=$max
printf '%s\n' "$index"
SHUF
chmod +x "$TEST_TMP/full-passes/bin/shuf"
previous=""
for pass in 1 2 3; do
  seen=()
  for pick in 1 2 3; do
    result=$(PATH="$TEST_TMP/full-passes/bin:$PATH" fetch)
    selected=$(jq -r '.urlbase' <<<"$result")
    [[ $selected != "$previous" ]]
    seen+=("$selected")
    previous=$selected
  done
  if [[ $(printf '%s\n' "${seen[@]}" | sort -u | wc -l) -ne 3 ]]; then
    printf 'shuffle pass %s repeated an image before exhausting the archive\n' "$pass" >&2
    exit 1
  fi
done

use_case malformed-archive
export TEST_BING_OLDER_FIXTURE=bing-malformed.json
typed=""
for pick in 1 2 3 4; do
  result=$(PATH="$TEST_TMP/full-passes/bin:$PATH" fetch)
  [[ $(jq -r '.urlbase' <<<"$result") != *TypedWallpaper* ]] || typed=$result
done
[[ -n $typed ]]
jq -e '.title == "" and .copyright == "" and .copyrightLink == "" and (.startDate | test("^[0-9]{8}$"))' \
  >/dev/null <<<"$typed"
[[ $(jq 'length' "$XDG_STATE_HOME/omarchy/fresh-wallpaper/history.json") -eq 4 ]]

use_case concatenated-json
concatenated="$TEST_TMP/concatenated-json/older.json"
printf '{"images":{}}\n' >"$concatenated"
cat -- "$TEST_FIXTURE_DIR/bing-older.json" >>"$concatenated"
export TEST_BING_OLDER_FIXTURE=$concatenated
for pick in 1 2 3; do
  result=$(fetch)
  jq -e '.urlbase | test("OlderWallpaper") | not' >/dev/null <<<"$result"
done
printf '["/th?id=OHR.FirstWallpaper_EN-US0000000001"]\n["/th?id=OHR.Unrelated"]\n' \
  >"$XDG_STATE_HOME/omarchy/fresh-wallpaper/history.json"
fetch >/dev/null
jq -se 'length == 1 and (.[0] | length) == 1' "$XDG_STATE_HOME/omarchy/fresh-wallpaper/history.json" >/dev/null
export TEST_BING_FIXTURE=$concatenated
if fetch >/dev/null 2>&1; then
  printf 'a concatenated newest archive page was accepted\n' >&2
  exit 1
fi

use_case older-archive
export TEST_BING_OLDER_FIXTURE=bing-older.json
seen=()
for pick in 1 2 3 4 5 6 7 8 9; do
  result=$(PATH="$TEST_TMP/full-passes/bin:$PATH" fetch)
  seen+=("$(jq -r '.urlbase' <<<"$result")")
done
if [[ $(printf '%s\n' "${seen[@]}" | sort -u | wc -l) -ne 9 ]]; then
  printf 'the older archive page did not extend the shuffle pass\n' >&2
  exit 1
fi
[[ $(jq 'length' "$XDG_STATE_HOME/omarchy/fresh-wallpaper/history.json") -eq 9 ]]

export TEST_FAIL_OLDER_ARCHIVE=1
newest_only=$(fetch --no-apply)
jq -e '.urlbase | test("OlderWallpaper") | not' >/dev/null <<<"$newest_only"

use_case previous
export TEST_BING_OLDER_FIXTURE=bing-older.json
if fetch --previous >/dev/null 2>&1; then
  printf 'previous without an earlier wallpaper unexpectedly succeeded\n' >&2
  exit 1
fi
if fetch --previous --no-apply >/dev/null 2>&1; then
  printf 'previous without applying unexpectedly succeeded\n' >&2
  exit 1
fi
picks=()
for pick in 1 2 3; do
  picks+=("$(PATH="$TEST_TMP/full-passes/bin:$PATH" fetch | jq -r '.path')")
done
back=$(fetch --previous)
[[ $(jq -r '.path' <<<"$back") == "${picks[1]}" ]]
jq -e '.applied == true and (.title | length) > 0' >/dev/null <<<"$back"
[[ $(tail -n 1 "$TEST_APPLY_LOG") == "${picks[1]}" ]]
[[ $(jq -r '.path' "$XDG_STATE_HOME/omarchy/fresh-wallpaper/current.json") == "${picks[1]}" ]]
[[ $(fetch --previous | jq -r '.path') == "${picks[0]}" ]]
if fetch --previous >/dev/null 2>&1; then
  printf 'previous went past the oldest wallpaper\n' >&2
  exit 1
fi
[[ $(wc -l <"$TEST_APPLY_LOG") -eq 5 ]]

for pick in 1 2; do
  picks+=("$(PATH="$TEST_TMP/full-passes/bin:$PATH" fetch | jq -r '.path')")
done
rm -f -- "${picks[3]}"
[[ $(fetch --previous | jq -r '.path') == "${picks[0]}" ]]

use_case previous-no-repeat
for pick in 1 2 3 4; do
  PATH="$TEST_TMP/full-passes/bin:$PATH" fetch >/dev/null
done
restored=$(fetch --previous | jq -r '.urlbase')
after_restore=$(TEST_SHUF_INDEX=1 PATH="$TEST_TMP/full-passes/bin:$PATH" fetch | jq -r '.urlbase')
if [[ $after_restore == "$restored" ]]; then
  printf 'the next change repeated the wallpaper Previous restored\n' >&2
  exit 1
fi

use_case previous-chronology
sequence=()
for index in 0 0 0 1; do
  sequence+=("$(TEST_SHUF_INDEX=$index PATH="$TEST_TMP/full-passes/bin:$PATH" fetch | jq -r '.path')")
done
[[ ${sequence[3]} == "${sequence[1]}" ]]
for expected in 2 1 0; do
  restored=$(fetch --previous | jq -r '.path')
  if [[ $restored != "${sequence[$expected]}" ]]; then
    printf 'Previous skipped a wallpaper in the chronological history\n' >&2
    exit 1
  fi
done
if fetch --previous >/dev/null 2>&1; then
  printf 'previous went past the first wallpaper\n' >&2
  exit 1
fi

use_case concurrent
picks=()
for pick in 1 2; do
  picks+=("$(PATH="$TEST_TMP/full-passes/bin:$PATH" fetch | jq -r '.path')")
done
applying="$TEST_TMP/concurrent/applying"
TEST_APPLY_STARTED="$applying" TEST_APPLY_DELAY=1 fetch >/dev/null &
background=$!
for attempt in {1..50}; do
  [[ ! -e $applying ]] || break
  sleep 0.1
done
[[ -e $applying ]]
concurrent_previous=$(fetch --previous | jq -r '.path')
wait "$background"
if [[ $concurrent_previous != "${picks[1]}" ]]; then
  printf 'Previous ran alongside another update instead of waiting for it\n' >&2
  exit 1
fi
jq -e --arg newer "${picks[1]}" --arg older "${picks[0]}" '[.[].path] == [$newer, $older]' \
  "$XDG_STATE_HOME/omarchy/fresh-wallpaper/recent.json" >/dev/null

use_case prune-history
export TEST_BING_OLDER_FIXTURE=bing-older.json
picks=()
for pick in 1 2 3 4 5 6 7 8; do
  picks+=("$(PATH="$TEST_TMP/full-passes/bin:$PATH" fetch --cache-limit 8 | jq -r '.path')")
done
for step in 1 2 3 4 5 6; do
  fetch --previous >/dev/null
done
PATH="$TEST_TMP/full-passes/bin:$PATH" fetch --cache-limit 8 >/dev/null
[[ $(find "$XDG_CACHE_HOME/omarchy/fresh-wallpaper" -maxdepth 1 -name 'bing-*.jpg' | wc -l) -eq 8 ]]
for expected in 1 0; do
  if [[ $(fetch --previous | jq -r '.path') != "${picks[$expected]}" ]]; then
    printf 'cache pruning deleted a wallpaper still in the Previous history\n' >&2
    exit 1
  fi
done

use_case interrupted-save
# Fails the second state-file rename of a run, interrupting between two saves.
mkdir -p "$TEST_TMP/interrupted-save/bin"
cat >"$TEST_TMP/interrupted-save/bin/mv" <<MV
#!/bin/sh
case "\$3" in
  */omarchy/fresh-wallpaper/*.json)
    count=\$(( \$(cat "\$TEST_MV_COUNT" 2>/dev/null || echo 0) + 1 ))
    echo "\$count" >"\$TEST_MV_COUNT"
    [ "\$count" -ne 2 ] || exit 1
    ;;
esac
exec $(command -v mv) "\$@"
MV
chmod +x "$TEST_TMP/interrupted-save/bin/mv"
interrupted() {
  rm -f -- "$TEST_TMP/interrupted-save/mv-count"
  ! TEST_MV_COUNT="$TEST_TMP/interrupted-save/mv-count" \
    PATH="$TEST_TMP/interrupted-save/bin:$TEST_TMP/full-passes/bin:$PATH" fetch "$@" >/dev/null 2>&1
}

picks=()
for pick in 1 2 3; do
  picks+=("$(PATH="$TEST_TMP/full-passes/bin:$PATH" fetch | jq -r '.path')")
done
interrupted --previous
if [[ $(fetch --previous | jq -r '.path') != "${picks[0]}" ]]; then
  printf 'Previous lost its place after an interrupted Previous\n' >&2
  exit 1
fi

rm -rf -- "$XDG_STATE_HOME"
picks=()
for pick in 1 2 3; do
  picks+=("$(PATH="$TEST_TMP/full-passes/bin:$PATH" fetch | jq -r '.path')")
done
interrupted
if [[ $(fetch --previous | jq -r '.path') != "${picks[2]}" ]]; then
  printf 'Previous lost its place after an interrupted change\n' >&2
  exit 1
fi

rm -rf -- "$XDG_STATE_HOME"
for pick in 1 2 3; do
  PATH="$TEST_TMP/full-passes/bin:$PATH" fetch >/dev/null
done
interrupted
displayed=$(tail -n 1 "$TEST_APPLY_LOG")
if [[ $(PATH="$TEST_TMP/full-passes/bin:$PATH" fetch | jq -r '.path') == "$displayed" ]]; then
  printf 'the change after an interrupted save repeated the wallpaper on screen\n' >&2
  exit 1
fi

use_case staged-save
mkdir -p "$TEST_TMP/staged-save/bin"
cat >"$TEST_TMP/staged-save/bin/mktemp" <<MKTEMP
#!/bin/sh
case "\$1" in
  *recent.json.tmp.*) exit 1 ;;
esac
exec $(command -v mktemp) "\$@"
MKTEMP
chmod +x "$TEST_TMP/staged-save/bin/mktemp"
fetch >/dev/null
saved_current=$(cat "$XDG_STATE_HOME/omarchy/fresh-wallpaper/current.json")
if PATH="$TEST_TMP/staged-save/bin:$PATH" fetch >/dev/null 2>&1; then
  printf 'an update that could not save its state unexpectedly succeeded\n' >&2
  exit 1
fi
if [[ $(wc -l <"$TEST_APPLY_LOG") -ne 1 \
    || $(cat "$XDG_STATE_HOME/omarchy/fresh-wallpaper/current.json") != "$saved_current" ]]; then
  printf 'a failed state save still changed the desktop or current wallpaper\n' >&2
  exit 1
fi
[[ -z $(find "$XDG_STATE_HOME/omarchy/fresh-wallpaper" -name '*.tmp.*') ]]

use_case long-metadata
long_fixture="$TEST_TMP/long-metadata/bing.json"
head -c 150000 /dev/zero | tr '\0' x \
  | jq -Rs --slurpfile base "$TEST_FIXTURE_DIR/bing.json" \
    '. as $long | $base[0] | .images |= map(.title = $long | .copyright = $long)' >"$long_fixture"
export TEST_BING_FIXTURE=$long_fixture
long_first=$(fetch)
jq -e '(.title | length) == 150000 and (.copyright | length) == 150000' >/dev/null <<<"$long_first"
fetch >/dev/null
[[ $(jq 'length' "$XDG_STATE_HOME/omarchy/fresh-wallpaper/recent.json") -eq 2 ]]
[[ $(fetch --previous | jq -r '.path') == "$(jq -r '.path' <<<"$long_first")" ]]
[[ $(jq 'length' "$XDG_STATE_HOME/omarchy/fresh-wallpaper/recent.json") -eq 1 ]]

use_case previous-upgrade
upgrade_state="$XDG_STATE_HOME/omarchy/fresh-wallpaper"
upgrade_path="$XDG_CACHE_HOME/omarchy/fresh-wallpaper/bing-20260801-Upgraded_EN-US0000000000-UHD.jpg"
mkdir -p "$upgrade_state" "$(dirname "$upgrade_path")"
cp -- "$TEST_FIXTURE_DIR/wallpaper.jpg" "$upgrade_path"
jq -cn --arg path "$upgrade_path" '{path: $path, title: "Upgraded", urlbase: "/th?id=OHR.Upgraded"}' \
  >"$upgrade_state/current.json"
fetch >/dev/null
restored=$(fetch --previous)
jq -e --arg path "$upgrade_path" '.path == $path and .title == "Upgraded"' >/dev/null <<<"$restored"

use_case fallback
export TEST_BING_FIXTURE=bing-single.json
export TEST_FAIL_UHD=1
export TEST_IMAGE_URL_LOG="$TEST_TMP/fallback/image-urls.log"
: >"$TEST_IMAGE_URL_LOG"
fallback=$(fetch --no-apply)
jq -e '.imageUrl | endswith("_1920x1080.jpg")' >/dev/null <<<"$fallback"
grep -q '_UHD.jpg$' "$TEST_IMAGE_URL_LOG"
grep -q '_1920x1080.jpg$' "$TEST_IMAGE_URL_LOG"

fallback_again=$(fetch --no-apply)
jq -e '.imageUrl | endswith("_1920x1080.jpg")' >/dev/null <<<"$fallback_again"
[[ $(jq -r '.path' <<<"$fallback_again") == "$(jq -r '.path' <<<"$fallback")" ]]
[[ $(wc -l <"$TEST_IMAGE_URL_LOG") -eq 3 ]]

unset TEST_FAIL_UHD
upgraded=$(fetch --no-apply)
jq -e '.imageUrl | endswith("_UHD.jpg")' >/dev/null <<<"$upgraded"
[[ $(jq -r '.path' <<<"$upgraded") != "$(jq -r '.path' <<<"$fallback")" ]]
[[ $(wc -l <"$TEST_IMAGE_URL_LOG") -eq 4 ]]
fetch --no-apply >/dev/null
[[ $(wc -l <"$TEST_IMAGE_URL_LOG") -eq 4 ]]
[[ $(find "$XDG_CACHE_HOME" -name '.download.*' | wc -l) -eq 0 ]]

use_case legacy-cache
export TEST_BING_FIXTURE=bing-single.json
export TEST_IMAGE_URL_LOG="$TEST_TMP/legacy-cache/image-urls.log"
legacy_path="$XDG_CACHE_HOME/omarchy/fresh-wallpaper/bing-20260817-OnlyWallpaper_EN-US0000000001.jpg"
mkdir -p "$(dirname "$legacy_path")"
cp -- "$TEST_FIXTURE_DIR/wallpaper.jpg" "$legacy_path"
fresh=$(fetch --no-apply)
[[ $(jq -r '.path' <<<"$fresh") != "$legacy_path" ]]
grep -q '_UHD.jpg$' "$TEST_IMAGE_URL_LOG"
[[ -f $legacy_path ]]

use_case prune
prune_cache_dir="$XDG_CACHE_HOME/omarchy/fresh-wallpaper"
prune_state_dir="$XDG_STATE_HOME/omarchy/fresh-wallpaper"
protected_path="$prune_cache_dir/bing-20260815-ThirdWallpaper_EN-US0000000003-UHD.jpg"
mkdir -p "$prune_cache_dir" "$prune_state_dir"
cp -- "$TEST_FIXTURE_DIR/wallpaper.jpg" "$protected_path"
touch -d '2026-01-01 00:00:00 UTC' "$protected_path"
for i in 1 2 3 4 5 6 7 8; do
  printf 'newer cache entry %s\n' "$i" >"$prune_cache_dir/bing-extra-$i.jpg"
  touch -d "2026-08-17 00:0${i}:00 UTC" "$prune_cache_dir/bing-extra-$i.jpg"
done
printf '%s\n' '["/th?id=OHR.FirstWallpaper_EN-US0000000001","/th?id=OHR.SecondWallpaper_EN-US0000000002"]' \
  >"$prune_state_dir/history.json"
printf '%s\n' '{"urlbase":"/th?id=OHR.FirstWallpaper_EN-US0000000001"}' \
  >"$prune_state_dir/current.json"

pruned=$(fetch --cache-limit 8)
[[ $(jq -r '.path' <<<"$pruned") == "$protected_path" ]]
[[ -f $protected_path ]]
[[ $(find "$prune_cache_dir" -maxdepth 1 -type f -name 'bing-*.jpg' | wc -l) -eq 8 ]]
[[ ! -e $prune_cache_dir/bing-extra-1.jpg ]]

use_case invalid-image
export TEST_IMAGE_FIXTURE=preview.svg
if fetch --no-apply >/dev/null 2>&1; then
  printf 'invalid image unexpectedly succeeded\n' >&2
  exit 1
fi

use_case truncated-image
export TEST_IMAGE_FIXTURE=truncated.jpg
[[ $(file --brief --mime-type "$TEST_FIXTURE_DIR/$TEST_IMAGE_FIXTURE") == image/jpeg ]]
if fetch >/dev/null 2>&1; then
  printf 'truncated JPEG unexpectedly succeeded\n' >&2
  exit 1
fi
[[ ! -s $TEST_APPLY_LOG ]]
[[ ! -e $XDG_STATE_HOME/omarchy/fresh-wallpaper/current.json ]]

use_case corrupt-cache
export TEST_BING_FIXTURE=bing-single.json
cached=$(fetch)
cached_path=$(jq -r '.path' <<<"$cached")
cp -- "$TEST_FIXTURE_DIR/truncated.jpg" "$cached_path"
repaired=$(fetch)
[[ $(jq -r '.path' <<<"$repaired") == "$cached_path" ]]
djpeg -strict -outfile /dev/null "$cached_path"
[[ $(wc -l <"$TEST_APPLY_LOG") -eq 2 ]]

use_case oversized-image
export TEST_OVERSIZE_IMAGE=1
if fetch --no-apply >/dev/null 2>&1; then
  printf 'oversized image unexpectedly succeeded\n' >&2
  exit 1
fi

if fetch --no-apply --network-wait-seconds 3601 >/dev/null 2>&1; then
  printf 'out-of-range network wait unexpectedly succeeded\n' >&2
  exit 1
fi

use_case offline
export TEST_OFFLINE=1
offline_status=0
fetch --no-apply --network-wait-seconds 0 >/dev/null 2>&1 || offline_status=$?
if [[ $offline_status -ne 75 ]]; then
  printf 'offline fetch exited %s, expected 75\n' "$offline_status" >&2
  exit 1
fi

printf 'fetch-wallpaper tests passed\n'
