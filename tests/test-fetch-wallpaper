#!/usr/bin/env bash

set -euo pipefail

PROJECT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
TEST_TMP=$(mktemp -d)
trap 'rm -rf -- "$TEST_TMP"' EXIT

export PATH="$PROJECT_DIR/tests/mocks:$PATH"
export TEST_FIXTURE_DIR="$PROJECT_DIR/tests/fixtures"

use_case() {
  local name="$1"

  export XDG_CACHE_HOME="$TEST_TMP/$name/cache"
  export XDG_STATE_HOME="$TEST_TMP/$name/state"
  export TEST_APPLY_LOG="$TEST_TMP/$name/applied.log"
  unset TEST_BING_FIXTURE TEST_BING_OLDER_FIXTURE TEST_FAIL_OLDER_ARCHIVE TEST_FAIL_UHD \
    TEST_IMAGE_URL_LOG TEST_IMAGE_FIXTURE TEST_OFFLINE TEST_OVERSIZE_IMAGE
  mkdir -p "$(dirname "$TEST_APPLY_LOG")"
  : >"$TEST_APPLY_LOG"
}

fetch() {
  "$PROJECT_DIR/scripts/fetch-wallpaper" --provider bing --market en-US "$@"
}

use_case rotation

first=$(fetch)
jq -e '.provider == "bing" and .market == "en-US" and .applied == true' >/dev/null <<<"$first"
jq -e '.imageUrl | endswith("_UHD.jpg")' >/dev/null <<<"$first"
first_urlbase=$(jq -r '.urlbase' <<<"$first")
first_path=$(jq -r '.path' <<<"$first")
[[ -f $first_path ]]
[[ $(jq -r '.urlbase' "$XDG_STATE_HOME/omarchy/fresh-wallpaper/current.json") == "$first_urlbase" ]]

second=$(fetch)
second_urlbase=$(jq -r '.urlbase' <<<"$second")
[[ $second_urlbase != "$first_urlbase" ]]
[[ $(wc -l <"$TEST_APPLY_LOG") -eq 2 ]]

dry_run=$(fetch --no-apply)
jq -e '.applied == false' >/dev/null <<<"$dry_run"
[[ $(wc -l <"$TEST_APPLY_LOG") -eq 2 ]]

third=$(fetch)
third_urlbase=$(jq -r '.urlbase' <<<"$third")
[[ $third_urlbase != "$first_urlbase" && $third_urlbase != "$second_urlbase" ]]
[[ $(jq 'length' "$XDG_STATE_HOME/omarchy/fresh-wallpaper/history.json") -eq 3 ]]

fourth=$(fetch)
fourth_urlbase=$(jq -r '.urlbase' <<<"$fourth")
[[ $fourth_urlbase != "$third_urlbase" ]]
[[ $(wc -l <"$TEST_APPLY_LOG") -eq 4 ]]

if fetch --provider unknown >/dev/null 2>&1; then
  printf 'unsupported provider unexpectedly succeeded\n' >&2
  exit 1
fi

use_case single-image
export TEST_BING_FIXTURE=bing-single.json
only=$(fetch)
only_again=$(fetch)
[[ $(jq -r '.urlbase' <<<"$only") == "$(jq -r '.urlbase' <<<"$only_again")" ]]
[[ $(wc -l <"$TEST_APPLY_LOG") -eq 2 ]]

use_case full-passes
mkdir -p "$TEST_TMP/full-passes/bin"
printf '#!/bin/sh\nprintf "0\\n"\n' >"$TEST_TMP/full-passes/bin/shuf"
chmod +x "$TEST_TMP/full-passes/bin/shuf"
previous=""
for pass in 1 2 3; do
  seen=()
  for pick in 1 2 3; do
    result=$(PATH="$TEST_TMP/full-passes/bin:$PATH" fetch)
    selected=$(jq -r '.urlbase' <<<"$result")
    [[ $selected != "$previous" ]]
    seen+=("$selected")
    previous=$selected
  done
  if [[ $(printf '%s\n' "${seen[@]}" | sort -u | wc -l) -ne 3 ]]; then
    printf 'shuffle pass %s repeated an image before exhausting the archive\n' "$pass" >&2
    exit 1
  fi
done

use_case malformed-archive
export TEST_BING_OLDER_FIXTURE=bing-malformed.json
typed=""
for pick in 1 2 3 4; do
  result=$(PATH="$TEST_TMP/full-passes/bin:$PATH" fetch)
  [[ $(jq -r '.urlbase' <<<"$result") != *TypedWallpaper* ]] || typed=$result
done
[[ -n $typed ]]
jq -e '.title == "" and .copyright == "" and .copyrightLink == "" and (.startDate | test("^[0-9]{8}$"))' \
  >/dev/null <<<"$typed"
[[ $(jq 'length' "$XDG_STATE_HOME/omarchy/fresh-wallpaper/history.json") -eq 4 ]]

use_case concatenated-json
concatenated="$TEST_TMP/concatenated-json/older.json"
printf '{"images":{}}\n' >"$concatenated"
cat -- "$TEST_FIXTURE_DIR/bing-older.json" >>"$concatenated"
export TEST_BING_OLDER_FIXTURE=$concatenated
for pick in 1 2 3; do
  result=$(fetch)
  jq -e '.urlbase | test("OlderWallpaper") | not' >/dev/null <<<"$result"
done
printf '["/th?id=OHR.FirstWallpaper_EN-US0000000001"]\n["/th?id=OHR.Unrelated"]\n' \
  >"$XDG_STATE_HOME/omarchy/fresh-wallpaper/history.json"
fetch >/dev/null
jq -se 'length == 1 and (.[0] | length) == 1' "$XDG_STATE_HOME/omarchy/fresh-wallpaper/history.json" >/dev/null
export TEST_BING_FIXTURE=$concatenated
if fetch >/dev/null 2>&1; then
  printf 'a concatenated newest archive page was accepted\n' >&2
  exit 1
fi

use_case older-archive
export TEST_BING_OLDER_FIXTURE=bing-older.json
seen=()
for pick in 1 2 3 4 5 6 7 8 9; do
  result=$(PATH="$TEST_TMP/full-passes/bin:$PATH" fetch)
  seen+=("$(jq -r '.urlbase' <<<"$result")")
done
if [[ $(printf '%s\n' "${seen[@]}" | sort -u | wc -l) -ne 9 ]]; then
  printf 'the older archive page did not extend the shuffle pass\n' >&2
  exit 1
fi
[[ $(jq 'length' "$XDG_STATE_HOME/omarchy/fresh-wallpaper/history.json") -eq 9 ]]

export TEST_FAIL_OLDER_ARCHIVE=1
newest_only=$(fetch --no-apply)
jq -e '.urlbase | test("OlderWallpaper") | not' >/dev/null <<<"$newest_only"

use_case fallback
export TEST_BING_FIXTURE=bing-single.json
export TEST_FAIL_UHD=1
export TEST_IMAGE_URL_LOG="$TEST_TMP/fallback/image-urls.log"
: >"$TEST_IMAGE_URL_LOG"
fallback=$(fetch --no-apply)
jq -e '.imageUrl | endswith("_1920x1080.jpg")' >/dev/null <<<"$fallback"
grep -q '_UHD.jpg$' "$TEST_IMAGE_URL_LOG"
grep -q '_1920x1080.jpg$' "$TEST_IMAGE_URL_LOG"

fallback_again=$(fetch --no-apply)
jq -e '.imageUrl | endswith("_1920x1080.jpg")' >/dev/null <<<"$fallback_again"
[[ $(jq -r '.path' <<<"$fallback_again") == "$(jq -r '.path' <<<"$fallback")" ]]
[[ $(wc -l <"$TEST_IMAGE_URL_LOG") -eq 3 ]]

unset TEST_FAIL_UHD
upgraded=$(fetch --no-apply)
jq -e '.imageUrl | endswith("_UHD.jpg")' >/dev/null <<<"$upgraded"
[[ $(jq -r '.path' <<<"$upgraded") != "$(jq -r '.path' <<<"$fallback")" ]]
[[ $(wc -l <"$TEST_IMAGE_URL_LOG") -eq 4 ]]
fetch --no-apply >/dev/null
[[ $(wc -l <"$TEST_IMAGE_URL_LOG") -eq 4 ]]
[[ $(find "$XDG_CACHE_HOME" -name '.download.*' | wc -l) -eq 0 ]]

use_case legacy-cache
export TEST_BING_FIXTURE=bing-single.json
export TEST_IMAGE_URL_LOG="$TEST_TMP/legacy-cache/image-urls.log"
legacy_path="$XDG_CACHE_HOME/omarchy/fresh-wallpaper/bing-20260817-OnlyWallpaper_EN-US0000000001.jpg"
mkdir -p "$(dirname "$legacy_path")"
cp -- "$TEST_FIXTURE_DIR/wallpaper.jpg" "$legacy_path"
fresh=$(fetch --no-apply)
[[ $(jq -r '.path' <<<"$fresh") != "$legacy_path" ]]
grep -q '_UHD.jpg$' "$TEST_IMAGE_URL_LOG"
[[ -f $legacy_path ]]

use_case prune
prune_cache_dir="$XDG_CACHE_HOME/omarchy/fresh-wallpaper"
prune_state_dir="$XDG_STATE_HOME/omarchy/fresh-wallpaper"
protected_path="$prune_cache_dir/bing-20260815-ThirdWallpaper_EN-US0000000003-UHD.jpg"
mkdir -p "$prune_cache_dir" "$prune_state_dir"
cp -- "$TEST_FIXTURE_DIR/wallpaper.jpg" "$protected_path"
touch -d '2026-01-01 00:00:00 UTC' "$protected_path"
for i in 1 2 3 4 5 6 7 8; do
  printf 'newer cache entry %s\n' "$i" >"$prune_cache_dir/bing-extra-$i.jpg"
  touch -d "2026-08-17 00:0${i}:00 UTC" "$prune_cache_dir/bing-extra-$i.jpg"
done
printf '%s\n' '["/th?id=OHR.FirstWallpaper_EN-US0000000001","/th?id=OHR.SecondWallpaper_EN-US0000000002"]' \
  >"$prune_state_dir/history.json"
printf '%s\n' '{"urlbase":"/th?id=OHR.FirstWallpaper_EN-US0000000001"}' \
  >"$prune_state_dir/current.json"

pruned=$(fetch --cache-limit 8)
[[ $(jq -r '.path' <<<"$pruned") == "$protected_path" ]]
[[ -f $protected_path ]]
[[ $(find "$prune_cache_dir" -maxdepth 1 -type f -name 'bing-*.jpg' | wc -l) -eq 8 ]]
[[ ! -e $prune_cache_dir/bing-extra-1.jpg ]]

use_case invalid-image
export TEST_IMAGE_FIXTURE=preview.svg
if fetch --no-apply >/dev/null 2>&1; then
  printf 'invalid image unexpectedly succeeded\n' >&2
  exit 1
fi

use_case truncated-image
export TEST_IMAGE_FIXTURE=truncated.jpg
[[ $(file --brief --mime-type "$TEST_FIXTURE_DIR/$TEST_IMAGE_FIXTURE") == image/jpeg ]]
if fetch >/dev/null 2>&1; then
  printf 'truncated JPEG unexpectedly succeeded\n' >&2
  exit 1
fi
[[ ! -s $TEST_APPLY_LOG ]]
[[ ! -e $XDG_STATE_HOME/omarchy/fresh-wallpaper/current.json ]]

use_case corrupt-cache
export TEST_BING_FIXTURE=bing-single.json
cached=$(fetch)
cached_path=$(jq -r '.path' <<<"$cached")
cp -- "$TEST_FIXTURE_DIR/truncated.jpg" "$cached_path"
repaired=$(fetch)
[[ $(jq -r '.path' <<<"$repaired") == "$cached_path" ]]
djpeg -strict -outfile /dev/null "$cached_path"
[[ $(wc -l <"$TEST_APPLY_LOG") -eq 2 ]]

use_case oversized-image
export TEST_OVERSIZE_IMAGE=1
if fetch --no-apply >/dev/null 2>&1; then
  printf 'oversized image unexpectedly succeeded\n' >&2
  exit 1
fi

if fetch --no-apply --network-wait-seconds 3601 >/dev/null 2>&1; then
  printf 'out-of-range network wait unexpectedly succeeded\n' >&2
  exit 1
fi

use_case offline
export TEST_OFFLINE=1
offline_status=0
fetch --no-apply --network-wait-seconds 0 >/dev/null 2>&1 || offline_status=$?
if [[ $offline_status -ne 75 ]]; then
  printf 'offline fetch exited %s, expected 75\n' "$offline_status" >&2
  exit 1
fi

printf 'fetch-wallpaper tests passed\n'
