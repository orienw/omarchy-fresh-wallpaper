#!/usr/bin/env bash

set -euo pipefail

TEST_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
PROJECT_DIR=$(cd "$TEST_DIR/.." && pwd)
OMARCHY_ROOT=${OMARCHY_PATH:-/usr/share/omarchy}
TEST_RUNTIME=$(mktemp -d /tmp/fresh-wallpaper-runtime.XXXXXX)
TEST_STATE=$(mktemp -d /tmp/fresh-wallpaper-state.XXXXXX)
TEST_CACHE=$(mktemp -d /tmp/fresh-wallpaper-cache.XXXXXX)
FIRST_RUN_STATE=$(mktemp -d /tmp/fresh-wallpaper-first-run-state.XXXXXX)
DUE_STARTUP_STATE=$(mktemp -d /tmp/fresh-wallpaper-due-startup-state.XXXXXX)
DUE_STARTUP_LOG=$(mktemp /tmp/fresh-wallpaper-due-startup-log.XXXXXX)
OFFLINE_STATE=$(mktemp -d /tmp/fresh-wallpaper-offline-state.XXXXXX)
RECOVERY_STATE=$(mktemp -d /tmp/fresh-wallpaper-recovery.XXXXXX)
BOUNDS_STATE=$(mktemp -d /tmp/fresh-wallpaper-bounds.XXXXXX)
trap 'rm -rf -- "$TEST_RUNTIME" "$TEST_STATE" "$TEST_CACHE" "$FIRST_RUN_STATE" \
  "$DUE_STARTUP_STATE" "$OFFLINE_STATE" "$RECOVERY_STATE" "$BOUNDS_STATE"; rm -f -- "$DUE_STARTUP_LOG"' EXIT

# The service only trusts wallpapers in the helper's cache.
export XDG_CACHE_HOME="$TEST_CACHE"
CACHE_DIR="$TEST_CACHE/omarchy/fresh-wallpaper"
mkdir -p "$CACHE_DIR"
export FRESH_WALLPAPER_TEST_IMAGE="$CACHE_DIR/bing-20260801-Test_EN-US0000000000-UHD.jpg"
cp -- "$TEST_DIR/fixtures/wallpaper.jpg" "$FRESH_WALLPAPER_TEST_IMAGE"
export FRESH_WALLPAPER_TEST_BACKGROUND="$TEST_CACHE/current-background"
export FRESH_WALLPAPER_TEST_REAL_HELPER="$PROJECT_DIR/scripts/fetch-wallpaper"

chmod 700 "$TEST_RUNTIME"
TEST_PLUGIN_DIR="$TEST_RUNTIME/plugin #?%"
mkdir -p "$TEST_PLUGIN_DIR/scripts"
cp -- "$PROJECT_DIR/Service.qml" "$TEST_PLUGIN_DIR/Service.qml"
cp -- "$TEST_DIR/fixtures/plugin/scripts/fetch-wallpaper" "$TEST_PLUGIN_DIR/scripts/fetch-wallpaper"
export FRESH_WALLPAPER_TEST_SERVICE_URL
FRESH_WALLPAPER_TEST_SERVICE_URL=$(jq -rn --arg path "$TEST_PLUGIN_DIR/Service.qml" \
  '"file://" + ($path | split("/") | map(@uri) | join("/"))')
STATE_DIR="$TEST_STATE/omarchy/fresh-wallpaper"
mkdir -p "$STATE_DIR"

shell_apis=("")
if [[ -f $OMARCHY_ROOT/shell/services/PluginShellApi.qml ]]; then
  shell_apis+=("file://$OMARCHY_ROOT/shell/services/PluginShellApi.qml")
fi
for shell_api in "${shell_apis[@]}"; do
  STATE_TIMESTAMP=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  jq -cn --arg path "$FRESH_WALLPAPER_TEST_IMAGE" --arg changedAt "$STATE_TIMESTAMP" \
    '{path: $path, changedAt: $changedAt}' > "$STATE_DIR/current.json"
  output=$(
    WAYLAND_DISPLAY= \
    XDG_RUNTIME_DIR="$TEST_RUNTIME" \
    XDG_STATE_HOME="$TEST_STATE" \
    PATH="$TEST_DIR/mocks:$PATH" \
    FRESH_WALLPAPER_TEST_SHELL_API="$shell_api" \
    QT_QPA_PLATFORM=offscreen \
      quickshell --no-color -p "$TEST_DIR/test-service.qml" 2>&1
  )

  if ! grep -q "service schedule tests passed" <<<"$output"; then
    printf '%s\n' "$output" >&2
    exit 1
  fi
done

first_run_output=$(
  WAYLAND_DISPLAY= \
  XDG_RUNTIME_DIR="$TEST_RUNTIME" \
  XDG_STATE_HOME="$FIRST_RUN_STATE" \
  QT_QPA_PLATFORM=offscreen \
    quickshell --no-color -p "$TEST_DIR/test-first-run.qml" 2>&1
)

if ! grep -q "service first-run test passed" <<<"$first_run_output"; then
  printf '%s\n' "$first_run_output" >&2
  exit 1
fi

mkdir -p "$DUE_STARTUP_STATE/omarchy/fresh-wallpaper"
jq -cn --arg path "$FRESH_WALLPAPER_TEST_IMAGE" \
  '{path: $path, changedAt: "2020-01-01T00:00:00Z"}' \
  >"$DUE_STARTUP_STATE/omarchy/fresh-wallpaper/current.json"

startup_output=$(
  WAYLAND_DISPLAY= \
  XDG_RUNTIME_DIR="$TEST_RUNTIME" \
  XDG_STATE_HOME="$DUE_STARTUP_STATE" \
  FRESH_WALLPAPER_TEST_FETCH_LOG="$DUE_STARTUP_LOG" \
  QT_QPA_PLATFORM=offscreen \
    quickshell --no-color -p "$TEST_DIR/test-startup.qml" 2>&1
)

if ! grep -q "service overdue startup test passed" <<<"$startup_output"; then
  printf '%s\n' "$startup_output" >&2
  exit 1
fi
if [[ $(wc -l <"$DUE_STARTUP_LOG") -ne 1 ]]; then
  printf 'overdue startup fetched more than once\n' >&2
  exit 1
fi

offline_output=$(
  WAYLAND_DISPLAY= \
  XDG_RUNTIME_DIR="$TEST_RUNTIME" \
  XDG_STATE_HOME="$OFFLINE_STATE" \
  FRESH_WALLPAPER_TEST_DEFER=1 \
  QT_QPA_PLATFORM=offscreen \
    quickshell --no-color -p "$TEST_DIR/test-offline.qml" 2>&1
)

if ! grep -q "service offline deferral test passed" <<<"$offline_output"; then
  printf '%s\n' "$offline_output" >&2
  exit 1
fi

for recovery_case in missing replaced; do
  recovery_dir="$RECOVERY_STATE/$recovery_case"
  mkdir -p "$recovery_dir/omarchy/fresh-wallpaper"
  deleted_path="$CACHE_DIR/bing-20200101-Deleted_EN-US0000000000-UHD.jpg"
  jq -cn --arg path "$deleted_path" --arg changedAt "$STATE_TIMESTAMP" \
    '{path: $path, changedAt: $changedAt}' >"$recovery_dir/omarchy/fresh-wallpaper/current.json"
  if [[ $recovery_case == missing ]]; then
    ln -s "$deleted_path" "$recovery_dir/background"
  else
    ln -s "$TEST_DIR/fixtures/wallpaper.jpg" "$recovery_dir/background"
  fi
  recovery_output=$(
    WAYLAND_DISPLAY= \
    XDG_RUNTIME_DIR="$TEST_RUNTIME" \
    XDG_STATE_HOME="$recovery_dir" \
    FRESH_WALLPAPER_TEST_BACKGROUND="$recovery_dir/background" \
    FRESH_WALLPAPER_TEST_RECOVERY="$recovery_case" \
    QT_QPA_PLATFORM=offscreen \
      quickshell --no-color -p "$TEST_DIR/test-recovery.qml" 2>&1
  )
  if ! grep -q 'service recovery test passed' <<<"$recovery_output"; then
    printf '%s\n' "$recovery_output" >&2
    exit 1
  fi
done

# A zombie counts as stopped. CI job containers run `tail -f /dev/null` as PID 1,
# which never reaps the orphans a timeout kills.
process_running() {
  [[ -r /proc/$1/status ]] && ! grep -q '^State:[[:space:]]*Z' "/proc/$1/status"
}

long_image="$CACHE_DIR/bing-20260803-$(printf 'L%.0s' {1..121})-UHD.jpg"
cp -- "$TEST_DIR/fixtures/wallpaper.jpg" "$long_image"
for bounds_case in symlink oversized fifo linked-dir foreign long-name \
    status-hang status-noisy hang noisy; do
  bounds_dir="$BOUNDS_STATE/$bounds_case"
  bounds_state_dir="$bounds_dir/omarchy/fresh-wallpaper"
  hang_pid=""
  noise=0
  status_mode=""
  status_log=""
  mkdir -p "$bounds_state_dir"
  jq -cn --arg path "$FRESH_WALLPAPER_TEST_IMAGE" --arg changedAt "$STATE_TIMESTAMP" \
    '{path: $path, changedAt: $changedAt}' >"$bounds_dir/trusted.json"
  case $bounds_case in
    symlink) ln -s -- "$bounds_dir/trusted.json" "$bounds_state_dir/current.json" ;;
    oversized)
      { cat -- "$bounds_dir/trusted.json"; head -c 270000 /dev/zero | tr '\0' '\n'; } \
        >"$bounds_state_dir/current.json"
      ;;
    fifo)
      # A second reader keeps the state buffered after the writer closes.
      mkfifo -- "$bounds_state_dir/current.json"
      exec 7<>"$bounds_state_dir/current.json" 8<"$bounds_state_dir/current.json"
      cat -- "$bounds_dir/trusted.json" >&7
      exec 7>&-
      ;;
    linked-dir)
      mv -- "$bounds_state_dir" "$bounds_dir/real"
      ln -s -- "$bounds_dir/real" "$bounds_state_dir"
      cp -- "$bounds_dir/trusted.json" "$bounds_dir/real/current.json"
      ;;
    foreign | long-name)
      case $bounds_case in
        foreign) untrusted_path="$TEST_DIR/fixtures/wallpaper.jpg" ;;
        long-name) untrusted_path=$long_image ;;
      esac
      jq -cn --arg path "$untrusted_path" --arg changedAt "$STATE_TIMESTAMP" \
        '{path: $path, changedAt: $changedAt}' >"$bounds_state_dir/current.json"
      ;;
    status-hang | status-noisy)
      cp -- "$bounds_dir/trusted.json" "$bounds_state_dir/current.json"
      status_mode=${bounds_case#status-}
      status_log="$bounds_dir/status.log"
      ;;
    hang) hang_pid="$bounds_dir/sleep.pid" ;;
    noisy) noise=1 ;;
  esac
  bounds_output=$(
    WAYLAND_DISPLAY= \
    XDG_RUNTIME_DIR="$TEST_RUNTIME" \
    XDG_STATE_HOME="$bounds_dir" \
    FRESH_WALLPAPER_TEST_BOUNDS="$bounds_case" \
    FRESH_WALLPAPER_TEST_HANG="$hang_pid" \
    FRESH_WALLPAPER_TEST_NOISE="$noise" \
    FRESH_WALLPAPER_TEST_STATUS="$status_mode" \
    FRESH_WALLPAPER_TEST_STATUS_LOG="$status_log" \
    QT_QPA_PLATFORM=offscreen \
      quickshell --no-color -p "$TEST_DIR/test-bounds.qml" 2>&1
  )
  [[ $bounds_case != fifo ]] || exec 8<&-
  if ! grep -q 'service bounds test passed' <<<"$bounds_output"; then
    printf '%s\n' "$bounds_output" >&2
    exit 1
  fi
  [[ $status_mode != hang ]] || hang_pid=$status_log
  if [[ -n $hang_pid ]] && process_running "$(cat -- "$hang_pid")"; then
    printf 'the timed-out helper left a process running\n' >&2
    exit 1
  fi
done

printf 'service schedule, first-run, startup, offline, recovery, and bounds tests passed\n'
