#!/usr/bin/env bash

set -euo pipefail

output=""
url=""

while (( $# > 0 )); do
  case "$1" in
    --output | -o)
      output=$2
      shift 2
      ;;
    --retry | --retry-delay | --connect-timeout | --max-time | --user-agent)
      shift 2
      ;;
    --fail | --silent | --show-error | --location)
      shift
      ;;
    *)
      url=$1
      shift
      ;;
  esac
done

if [[ $url == *HPImageArchive.aspx* ]]; then
  command cat "$TEST_FIXTURE_DIR/bing.json"
  exit 0
fi

[[ -n $output ]] || exit 1
printf 'mock jpeg for %s\n' "$url" >"$output"
