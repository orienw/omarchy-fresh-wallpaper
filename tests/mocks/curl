#!/usr/bin/env bash

set -euo pipefail

output=""
url=""
proto=""
proto_redir=""
max_redirs=""
max_filesize=""
connect_timeout=""
max_time=""
retry=""
user_agent=""

while (( $# > 0 )); do
  case "$1" in
    --output | -o)
      output=$2
      shift 2
      ;;
    --connect-timeout)
      connect_timeout=$2
      shift 2
      ;;
    --max-time)
      max_time=$2
      shift 2
      ;;
    --retry)
      retry=$2
      shift 2
      ;;
    --user-agent)
      user_agent=$2
      shift 2
      ;;
    --retry-delay)
      shift 2
      ;;
    --proto)
      proto=$2
      shift 2
      ;;
    --proto-redir)
      proto_redir=$2
      shift 2
      ;;
    --max-redirs)
      max_redirs=$2
      shift 2
      ;;
    --max-filesize)
      max_filesize=$2
      shift 2
      ;;
    --fail | --silent | --show-error | --location)
      shift
      ;;
    *)
      url=$1
      shift
      ;;
  esac
done

if [[ ${TEST_OFFLINE:-0} == 1 ]]; then
  exit 6
fi

if [[ $url == "https://www.bing.com/" || $url == "https://www.bing.com" ]]; then
  [[ $proto == "=https" && $proto_redir == "=https" && $max_redirs == 3 \
    && $connect_timeout == 3 && $max_time == 8 && $retry == 0 \
    && $user_agent == "omarchy-fresh-wallpaper/0.1.2" && $output == /dev/null ]] || exit 2
  exit 0
fi

if [[ $url == *HPImageArchive.aspx* ]]; then
  [[ $proto == "=https" && $proto_redir == "=https" && $max_redirs == 3 \
    && $max_filesize == 2097152 ]] || exit 2
  command cat "$TEST_FIXTURE_DIR/${TEST_BING_FIXTURE:-bing.json}"
  exit 0
fi

[[ -n $output ]] || exit 1
[[ $proto == "=https" && $proto_redir == "=https" && $max_redirs == 3 \
  && $max_filesize == 52428800 ]] || exit 2
if [[ -n ${TEST_IMAGE_URL_LOG:-} ]]; then
  printf '%s\n' "$url" >> "$TEST_IMAGE_URL_LOG"
fi
if [[ ${TEST_FAIL_UHD:-0} == 1 && $url == *_UHD.jpg ]]; then
  exit 22
fi
if [[ ${TEST_OVERSIZE_IMAGE:-0} == 1 ]]; then
  exit 63
fi
printf 'mock jpeg for %s\n' "$url" >"$output"
