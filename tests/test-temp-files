#!/usr/bin/env bash

set -euo pipefail

PROJECT_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
HELPER=${1:-"$PROJECT_DIR/scripts/fetch-wallpaper"}
TEST_ROOT=$(mktemp -d)
trap 'rm -rf -- "$TEST_ROOT"' EXIT

export PATH="$PROJECT_DIR/tests/mocks:$PATH"
export TEST_FIXTURE_DIR="$PROJECT_DIR/tests/fixtures"
export TEST_REAL_PYTHON
TEST_REAL_PYTHON=$(command -v python3)
mkdir "$TEST_ROOT/bin"

# Replace the name immediately after atomic creation, while its fd is still open.
cat >"$TEST_ROOT/replace.py" <<'PYTHON'
import os
import runpy
import sys
import tempfile

create = tempfile.mkstemp

def replace(*args, **kwargs):
    fd, name = create(*args, **kwargs)
    if os.environ["TEST_TEMP_PREFIX"] in name:
        os.unlink(name)
        kind = os.environ["TEST_TEMP_KIND"]
        if kind == "fifo":
            os.mkfifo(name)
        elif kind == "hardlink":
            os.link(os.environ["TEST_TEMP_VICTIM"], name)
        else:
            os.symlink(os.environ["TEST_TEMP_VICTIM"], name)
        with open(os.environ["TEST_TEMP_MARKER"], "w"):
            pass
    return fd, name

tempfile.mkstemp = replace
sys.argv = sys.argv[2:]  # Drop this driver and the interpreter's -I argument.
runpy.run_path(sys.argv[0], run_name="__main__")
PYTHON
cat >"$TEST_ROOT/bin/python3" <<'SH'
#!/usr/bin/env bash
exec "$TEST_REAL_PYTHON" -I "$TEST_TEMP_DRIVER" "$@"
SH

# The released helper reopened mktemp's name. Keep that boundary testable too.
cat >"$TEST_ROOT/bin/mktemp" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
name=$(/usr/bin/mktemp "$@")
if [[ $name == *"$TEST_TEMP_PREFIX"* ]]; then
  rm -f -- "$name"
  case "$TEST_TEMP_KIND" in
    fifo) mkfifo -- "$name" ;;
    hardlink) ln -- "$TEST_TEMP_VICTIM" "$name" ;;
    *) ln -s -- "$TEST_TEMP_VICTIM" "$name" ;;
  esac
  : >"$TEST_TEMP_MARKER"
fi
printf '%s\n' "$name"
SH
chmod +x "$TEST_ROOT/bin/python3" "$TEST_ROOT/bin/mktemp"
export TEST_TEMP_DRIVER="$TEST_ROOT/replace.py"

for storage in state cache; do
  for kind in symlink dangling hardlink fifo; do
    case_dir="$TEST_ROOT/$storage-$kind"
    mkdir "$case_dir"
    export XDG_STATE_HOME="$case_dir/state" XDG_CACHE_HOME="$case_dir/cache"
    export TEST_APPLY_LOG="$case_dir/applied"
    export TEST_TEMP_KIND="$kind" TEST_TEMP_VICTIM="$case_dir/victim" TEST_TEMP_MARKER="$case_dir/swapped"
    export TEST_TEMP_PREFIX=recent.json.tmp.
    [[ $storage != cache ]] || TEST_TEMP_PREFIX=.download.
    printf 'untouched\n' >"$case_dir/expected"
    [[ $kind == dangling ]] || cp "$case_dir/expected" "$TEST_TEMP_VICTIM"

    result=0
    PATH="$TEST_ROOT/bin:$PATH" timeout 10 "$HELPER" >"$case_dir/result" 2>"$case_dir/error" || result=$?
    [[ -f $TEST_TEMP_MARKER ]] || { cat "$case_dir/error" >&2; exit 1; }
    if [[ $kind == dangling ]]; then
      unchanged=0
      [[ ! -e $TEST_TEMP_VICTIM ]] || unchanged=1
    else
      unchanged=0
      cmp -s "$case_dir/expected" "$TEST_TEMP_VICTIM" || unchanged=1
    fi
    if (( unchanged != 0 || result == 0 || result == 124 )) || [[ -s $TEST_APPLY_LOG ]]; then
      printf '%s/%s: temporary-file substitution was not safely rejected (exit %s)\n' "$storage" "$kind" "$result" >&2
      exit 1
    fi
    if [[ -n $(find "$case_dir/state" "$case_dir/cache" -name '*.tmp.*' -o -name '.download.*') ]]; then
      printf '%s/%s: temporary-file cleanup failed\n' "$storage" "$kind" >&2
      exit 1
    fi
  done
done

"$TEST_REAL_PYTHON" - "$(dirname "$HELPER")/write-temp" "$TEST_ROOT" <<'PYTHON'
import os
from pathlib import Path
import signal
import subprocess
import sys
import time

writer, root = sys.argv[1:]
for signum in (signal.SIGHUP, signal.SIGTERM):
    directory = Path(root) / signum.name
    directory.mkdir()
    marker = directory / "child.pid"
    process = subprocess.Popen([
        sys.executable, "-I", writer, str(directory / ".download."),
        sys.executable, "-c",
        "import os, pathlib, sys, time; "
        "pathlib.Path(sys.argv[1]).write_text(str(os.getpid())); time.sleep(60)",
        str(marker),
    ], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    child = None
    try:
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline:
            try:
                child = int(marker.read_text())
                break
            except (FileNotFoundError, ValueError):
                time.sleep(0.01)
        assert child is not None, "download child did not start"
        process.send_signal(signum)
        output, error = process.communicate(timeout=5)
        assert process.returncode == 128 + signum, (signum.name, process.returncode, error)
        assert not list(directory.glob(".download.*")), "interrupted download was not removed"
        try:
            os.kill(child, 0)
        except ProcessLookupError:
            child = None
        assert child is None, "interrupted download child is still running"
    finally:
        if process.poll() is None:
            process.kill()
            process.wait()
        if child is not None:
            try:
                os.kill(child, signal.SIGKILL)
            except ProcessLookupError:
                pass
PYTHON

export XDG_STATE_HOME="$TEST_ROOT/stale-state" XDG_CACHE_HOME="$TEST_ROOT/stale-cache"
state_dir="$XDG_STATE_HOME/omarchy/fresh-wallpaper"
cache_dir="$XDG_CACHE_HOME/omarchy/fresh-wallpaper"
mkdir -p "$state_dir" "$cache_dir/.download.directory"
for target in current recent history; do
  printf 'unfinished\n' >"$state_dir/$target.json.tmp.stale"
done
printf 'partial\n' >"$cache_dir/.download.stale"
printf 'untouched\n' >"$TEST_ROOT/stale-victim"
ln -s -- "$TEST_ROOT/stale-victim" "$cache_dir/.download.link"
touch "$state_dir/unrelated.tmp.file" "$cache_dir/.download.directory/keep"
"$HELPER" --status >/dev/null
[[ -f $state_dir/current.json.tmp.stale && -f $cache_dir/.download.stale ]]
"$HELPER" --no-apply >/dev/null
[[ -z $(find "$state_dir" -maxdepth 1 -name '*.json.tmp.*') ]]
[[ ! -e $cache_dir/.download.stale && ! -L $cache_dir/.download.link ]]
[[ $(cat "$TEST_ROOT/stale-victim") == untouched ]]
[[ -f $state_dir/unrelated.tmp.file && -f $cache_dir/.download.directory/keep ]]

printf 'Temporary-file tests passed\n'
