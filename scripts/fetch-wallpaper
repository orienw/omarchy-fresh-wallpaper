#!/usr/bin/env bash

set -euo pipefail

PROVIDER="bing"
MARKET="en-US"
CACHE_LIMIT=30
APPLY=1
PREVIOUS=0
STATUS=0
BACKGROUND_LINK="$HOME/.local/state/omarchy/current/background"
VERSION="0.1.5"
NETWORK_WAIT_SECONDS=60
ARCHIVE_MAX_BYTES=2097152
IMAGE_MAX_BYTES=52428800
# Service.qml reads state files with the same limit. Capped metadata keeps them
# far below it, and FIT_STATE trims anything older that would not fit.
STATE_MAX_BYTES=262144

usage() {
  cat <<'USAGE'
Usage: fetch-wallpaper [options]

Options:
  --provider <name>              Wallpaper provider (default: bing)
  --market <locale>              Bing market, such as en-US (default: en-US)
  --cache-limit <count>          Number of downloaded images to retain (default: 30)
  --network-wait-seconds <secs>  Wait for HTTPS connectivity before downloading (default: 60)
  --no-apply                     Download and report a wallpaper without applying it
  --previous                     Restore the wallpaper applied before the current one
  --status                       Print the saved wallpaper state for the shell
  --background <path>            Omarchy's background link, checked by --status
  -h, --help                     Show this help
USAGE
}

fail() {
  printf 'fresh-wallpaper: %s\n' "$*" >&2
  exit 1
}

network_unavailable() {
  printf 'fresh-wallpaper: network is not ready\n' >&2
  exit 75
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || fail "required command not found: $1"
}

# Prints the JSON on stdin if it is exactly one document satisfying the jq
# condition $1. Fails for anything else, including concatenated documents.
one_json() {
  jq -cs "if length == 1 and (.[0] | $1) then .[0] else error(\"unexpected JSON\") end"
}

# Prints a regular state file of at most STATE_MAX_BYTES without following a
# symlink or waiting on a FIFO, so no other file can stand in for it. base64
# carries the exact bytes, which command substitution would strip. Fails otherwise.
read_state() {
  local encoded
  local padding

  [[ -f $1 && ! -L $1 ]] || return 1
  encoded=$(dd if="$1" bs=$((STATE_MAX_BYTES + 1)) count=1 iflag=nofollow,nonblock,fullblock status=none \
    | base64 -w 0) || return 1
  padding=${encoded##*[!=]}
  (( ${#encoded} / 4 * 3 - ${#padding} <= STATE_MAX_BYTES )) && base64 -d <<<"$encoded"
}

staged_files=()
staged_targets=()

# Writes a state file beside its target without replacing it yet, so a full
# disk fails before the desktop changes. commit_state renames them into place in
# the order they were staged.
stage_state() {
  local temporary

  temporary=$(mktemp "$1.tmp.XXXXXX")
  staged_files+=("$temporary")
  staged_targets+=("$1")
  printf '%s\n' "$2" >"$temporary"
}

commit_state() {
  local i

  for i in "${!staged_files[@]}"; do
    mv -T -- "${staged_files[$i]}" "${staged_targets[$i]}"
  done
  staged_files=()
  staged_targets=()
}

cleanup() {
  [[ -z ${partial:-} ]] || rm -f -- "$partial"
  (( ${#staged_files[@]} == 0 )) || rm -f -- "${staged_files[@]}"
}
trap cleanup EXIT

# Feeds JSON values to a jq filter through stdin, which has no size limit, unlike
# command-line arguments. The filter reads them in order with `input`.
jq_inputs() {
  local filter=$1
  shift
  printf '%s\n' "$@" | jq -cn "$filter"
}

# Collapses consecutive entries for the same file in the newest-first list of
# applied wallpapers, so each Previous step changes the desktop.
RECENT_COLLAPSE='reduce .[] as $entry ([]; if length > 0 and .[-1].path == $entry.path then . else . + [$entry] end)'

# Accepts only a wallpaper this helper downloaded into its cache, so state that
# names any other file is never checked, restored, or applied.
CACHED_WALLPAPER='def cached($cache): type == "object" and (.path | type) == "string"
  and (.path | startswith($cache + "/"))
  and (.path | ltrimstr($cache + "/") | test("^bing-[0-9]{8}-[A-Za-z0-9._-]{1,120}-(UHD|1920x1080)\\.jpg$"));'

# Drops the oldest entries of a state list until it fits in STATE_MAX_BYTES with
# its trailing newline, so the helper never saves a file it would then reject.
FIT_STATE="until((tojson | utf8bytelength) < $STATE_MAX_BYTES; .[:-1])"

# A preview only reads a regular, non-empty file within the download limit, never
# a symlink, a FIFO, or an oversized image.
previewable() {
  [[ -f $1 && -s $1 && ! -L $1 ]] && (( $(stat -c %s -- "$1") <= IMAGE_MAX_BYTES ))
}

valid_jpeg() {
  previewable "$1" && djpeg -strict -outfile /dev/null "$1" 2>/dev/null
}

download_image() {
  local url="$1"
  local output="$2"

  curl \
    --fail \
    --silent \
    --show-error \
    --location \
    --proto '=https' \
    --proto-redir '=https' \
    --max-redirs 3 \
    --max-filesize "$IMAGE_MAX_BYTES" \
    --retry 2 \
    --retry-delay 1 \
    --connect-timeout 10 \
    --max-time 90 \
    --user-agent "omarchy-fresh-wallpaper/${VERSION}" \
    --output "$output" \
    "$url"
}

network_available() {
  curl \
    --silent \
    --show-error \
    --location \
    --proto '=https' \
    --proto-redir '=https' \
    --max-redirs 3 \
    --connect-timeout 3 \
    --max-time 8 \
    --retry 0 \
    --user-agent "omarchy-fresh-wallpaper/${VERSION}" \
    --output /dev/null \
    "https://www.bing.com/" >/dev/null 2>&1
}

wait_for_network() {
  local wait_seconds=$NETWORK_WAIT_SECONDS
  local deadline=$((SECONDS + wait_seconds))
  local delay=1
  local remaining
  local nm_wait

  if (( wait_seconds > 0 )) && command -v nm-online >/dev/null 2>&1; then
    nm_wait=$((deadline - SECONDS))
    if (( nm_wait > 15 )); then
      nm_wait=15
    fi
    if (( nm_wait > 0 )); then
      nm-online -q -s -t "$nm_wait" >/dev/null 2>&1 || true
    fi
  fi

  while true; do
    if network_available; then
      return 0
    fi
    if (( wait_seconds <= 0 || SECONDS >= deadline )); then
      return 1
    fi
    remaining=$((deadline - SECONDS))
    if (( remaining < 1 )); then
      return 1
    fi
    if (( delay > remaining )); then
      delay=$remaining
    fi
    sleep "$delay"
    if (( delay < 8 )); then
      delay=$((delay * 2))
    fi
  done
}

# Keeps every file passed in, which covers the current wallpaper and the
# Previous history, then the newest other downloads up to the cache limit.
prune_cache() {
  local -a protected=("$@")
  local -a entries=()
  local -a others=()
  local entry
  local path
  local candidate
  local is_protected
  local keep_count=$CACHE_LIMIT

  mapfile -d '' -t entries < <(
    find "$CACHE_DIR" -maxdepth 1 -type f -name 'bing-*.jpg' -printf '%T@\t%p\0' | sort -z -nr
  )

  for entry in "${entries[@]}"; do
    path=${entry#*$'\t'}
    is_protected=0
    for candidate in "${protected[@]}"; do
      [[ $candidate != "$path" ]] || is_protected=1
    done
    if (( is_protected )); then
      keep_count=$((keep_count - 1))
    else
      others+=("$path")
    fi
  done

  (( keep_count >= 0 )) || keep_count=0
  for path in "${others[@]:keep_count}"; do
    rm -f -- "$path"
  done
}

while (( $# > 0 )); do
  case "$1" in
    --provider)
      [[ $# -ge 2 ]] || fail "--provider requires a value"
      PROVIDER=${2,,}
      shift 2
      ;;
    --market)
      [[ $# -ge 2 ]] || fail "--market requires a value"
      MARKET=$2
      shift 2
      ;;
    --cache-limit)
      [[ $# -ge 2 ]] || fail "--cache-limit requires a value"
      CACHE_LIMIT=$2
      shift 2
      ;;
    --network-wait-seconds)
      [[ $# -ge 2 ]] || fail "--network-wait-seconds requires a value"
      NETWORK_WAIT_SECONDS=$2
      shift 2
      ;;
    --no-apply)
      APPLY=0
      shift
      ;;
    --previous)
      PREVIOUS=1
      shift
      ;;
    --status)
      STATUS=1
      shift
      ;;
    --background)
      [[ $# -ge 2 ]] || fail "--background requires a value"
      BACKGROUND_LINK=$2
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      fail "unknown option: $1"
      ;;
  esac
done

[[ $PROVIDER == "bing" ]] || fail "unsupported provider: $PROVIDER"
[[ $MARKET =~ ^[A-Za-z]{2,3}-[A-Za-z]{2}$ ]] || fail "invalid Bing market: $MARKET"
[[ $CACHE_LIMIT =~ ^[0-9]+$ ]] || fail "cache limit must be an integer"
(( CACHE_LIMIT >= 8 && CACHE_LIMIT <= 100 )) || fail "cache limit must be between 8 and 100"
[[ $NETWORK_WAIT_SECONDS =~ ^[0-9]+$ ]] || fail "network wait must be an integer"
(( NETWORK_WAIT_SECONDS <= 3600 )) || fail "network wait must be 0-3600 seconds"
(( !PREVIOUS || APPLY )) || fail "--previous cannot be combined with --no-apply"
(( !STATUS || (APPLY && !PREVIOUS) )) || fail "--status cannot be combined with --previous or --no-apply"

require_command curl
require_command djpeg
require_command jq
require_command shuf
require_command flock
if (( APPLY && !STATUS )); then require_command omarchy; fi

CACHE_HOME=${XDG_CACHE_HOME:-"$HOME/.cache"}
STATE_HOME=${XDG_STATE_HOME:-"$HOME/.local/state"}
CACHE_DIR="$CACHE_HOME/omarchy/fresh-wallpaper"
STATE_DIR="$STATE_HOME/omarchy/fresh-wallpaper"
CURRENT_FILE="$STATE_DIR/current.json"
HISTORY_FILE="$STATE_DIR/history.json"
RECENT_FILE="$STATE_DIR/recent.json"

# Reads the saved wallpaper and the applied wallpapers, newest first. That list is
# the record Previous trusts, and it is always saved before current.json. The
# current wallpaper only seeds it for state from earlier versions, which kept
# current.json alone.
load_state() {
  current=$(read_state "$CURRENT_FILE" 2>/dev/null | one_json 'type == "object"' 2>/dev/null) || current='null'
  if recent_file=$(read_state "$RECENT_FILE" 2>/dev/null | one_json 'type == "array"' 2>/dev/null); then
    recent=$(jq -c --arg cache "$CACHE_DIR" "$CACHED_WALLPAPER [.[] | select(cached(\$cache))] | $RECENT_COLLAPSE" \
      <<<"$recent_file")
  else
    recent=$(jq -c --arg cache "$CACHE_DIR" "$CACHED_WALLPAPER if cached(\$cache) then [.] else [] end" <<<"$current")
  fi
}

# Prints everything the shell shows, so the shell never reads the state files or
# the paths they name itself: the saved wallpaper, how many applied wallpapers
# Previous can use, the wallpaper file if it can be previewed, whether the desktop
# has a background, and that background when it is another previewable file.
print_status() {
  local path=""
  local wallpaper=""
  local wallpaper_file=""
  local desktop=""
  local external=""
  local has_background=false

  current='null'
  recent='[]'
  if [[ ! -L $STATE_DIR && ! -L $CACHE_DIR ]]; then
    load_state
    path=$(jq -r --arg cache "$CACHE_DIR" "$CACHED_WALLPAPER if cached(\$cache) then .path else \"\" end" <<<"$current")
  fi
  if [[ -n $path ]]; then
    if previewable "$path"; then wallpaper=$path; fi
    wallpaper_file=$(readlink -e -- "$path") || wallpaper_file=""
  fi
  if desktop=$(readlink -e -- "$BACKGROUND_LINK") && [[ -f $desktop && -s $desktop ]]; then
    has_background=true
    if [[ $desktop != "$wallpaper_file" ]] && previewable "$desktop"; then external=$desktop; fi
  fi

  printf '%s\n' "$current" "$recent" | jq -cn --arg cache "$CACHE_DIR" --arg wallpaper "$wallpaper" \
    --arg external "$external" --argjson hasBackground "$has_background" "$CACHED_WALLPAPER
    input as \$current | input as \$recent | {
      current: (if \$current | cached(\$cache) then \$current else null end),
      recentCount: (\$recent | length),
      wallpaper: \$wallpaper,
      external: \$external,
      hasBackground: \$hasBackground
    }"
}

if (( STATUS )); then
  print_status
  exit 0
fi

mkdir -p -- "$CACHE_DIR" "$STATE_DIR"
[[ ! -L $CACHE_DIR && ! -L $STATE_DIR ]] || fail "the plugin cache and state directories must not be symlinks"

# Serialize helpers so concurrent runs cannot overwrite each other's state. The
# lock is held on the state directory itself, so no lock file can redirect it.
exec 9<"$STATE_DIR"
flock -w 300 9 || fail "another wallpaper update is still running"

load_state

if (( PREVIOUS )); then
  recent_count=$(jq 'length' <<<"$recent")
  current_path=$(jq -r '.[0].path // ""' <<<"$recent")
  restore_index=""
  for ((i = 1; i < recent_count; i++)); do
    candidate_path=$(jq -r --argjson i "$i" '.[$i].path' <<<"$recent")
    if [[ $candidate_path != "$current_path" ]] && valid_jpeg "$candidate_path"; then
      restore_index=$i
      break
    fi
  done
  [[ -n $restore_index ]] || fail "no previous wallpaper is available"

  changed_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  next_recent=$(jq -c --argjson i "$restore_index" --arg changedAt "$changed_at" \
    "[.[\$i] + {changedAt: \$changedAt, applied: true}] + .[\$i + 1:] | $RECENT_COLLAPSE | $FIT_STATE" <<<"$recent")
  result=$(jq -c '.[0]' <<<"$next_recent")
  image_path=$(jq -r '.path' <<<"$result")
  stage_state "$RECENT_FILE" "$next_recent"
  stage_state "$CURRENT_FILE" "$result"
  omarchy theme bg set "$image_path" 9>&-
  touch -- "$image_path"
  commit_state
  printf '%s\n' "$result"
  exit 0
fi

if ! wait_for_network; then
  network_unavailable
fi

encoded_market=$(jq -rn --arg value "$MARKET" '$value | @uri')

fetch_archive() {
  curl \
    --fail \
    --silent \
    --show-error \
    --location \
    --proto '=https' \
    --proto-redir '=https' \
    --max-redirs 3 \
    --max-filesize "$ARCHIVE_MAX_BYTES" \
    --retry 2 \
    --retry-delay 1 \
    --connect-timeout 10 \
    --max-time 45 \
    --user-agent "omarchy-fresh-wallpaper/${VERSION}" \
    "https://www.bing.com/HPImageArchive.aspx?format=js&idx=$1&n=8&mkt=${encoded_market}"
}

archive_page() {
  one_json 'type == "object" and (.images | type) == "array" and (.images | length) > 0' <<<"$1"
}

archive=$(fetch_archive 0) || fail "could not fetch the Bing image archive"
archive=$(archive_page "$archive" 2>/dev/null) || fail "Bing returned an invalid image archive"

# Bing serves eight images per request. A second page starting seven days back
# extends the pool to about two weeks; the newest page alone is enough if it fails.
if older_archive=$(fetch_archive 7 2>/dev/null) && older_archive=$(archive_page "$older_archive" 2>/dev/null); then
  archive=$(printf '%s\n%s\n' "$archive" "$older_archive" | jq -cs '{images: (map(.images) | add)}')
fi

all_candidates=$(jq -c '
  def text: if type == "string" and length <= 1024 then . else "" end;
  [.images[]
    | select(type == "object")
    | select(.wp == null or .wp == true)
    | select((.urlbase | type) == "string" and (.urlbase | test("^/th\\?id=OHR\\.[A-Za-z0-9_.-]{1,120}$")))
    | {
        startDate: (.startdate | text),
        urlbase: .urlbase,
        title: (.title | text),
        copyright: (.copyright | text),
        copyrightLink: (.copyrightlink | text)
      }
  ] | unique_by(.urlbase)
' <<<"$archive")

(( $(jq 'length' <<<"$all_candidates") > 0 )) || fail "Bing returned no downloadable wallpapers"

history=$(read_state "$HISTORY_FILE" 2>/dev/null \
  | one_json 'type == "array" and all(.[]; type == "string")' 2>/dev/null) || history='[]'

current_urlbase=$(jq -c '.[0].urlbase // ""' <<<"$recent")

# Never repeat the image on screen while others are available, including one
# that Previous restored. Start a new pass once every other image has been used.
selection=$(jq_inputs '
  input as $all | input as $seen | input as $current
  | [$all[] | select(.urlbase != $current)] as $others
  | [$others[] | select(.urlbase as $candidate | $seen | index($candidate) | not)] as $unseen
  | if ($unseen | length) > 0 then {history: $seen, candidates: $unseen}
    elif ($others | length) > 0 then {history: [], candidates: $others}
    else {history: [], candidates: $all}
    end
' "$all_candidates" "$history" "$current_urlbase")
history=$(jq -c '.history' <<<"$selection")
candidates=$(jq -c '.candidates' <<<"$selection")

candidate_count=$(jq 'length' <<<"$candidates")
candidate_index=$(shuf -i "0-$((candidate_count - 1))" -n 1)
selected=$(jq -c --argjson index "$candidate_index" '.[$index]' <<<"$candidates")

start_date=$(jq -r '.startDate' <<<"$selected")
urlbase=$(jq -r '.urlbase' <<<"$selected")

[[ $start_date =~ ^[0-9]{8}$ ]] || start_date=$(date -u +%Y%m%d)
slug=${urlbase#*OHR.}
slug=$(printf '%s' "$slug" | tr -cs '[:alnum:]._-' '-')
slug=${slug#-}
slug=${slug%-}
[[ -n $slug ]] || fail "Bing returned an invalid wallpaper identifier"

image_url="https://www.bing.com${urlbase}_UHD.jpg"
fallback_image_url="https://www.bing.com${urlbase}_1920x1080.jpg"
image_base="$CACHE_DIR/bing-${start_date}-${slug}"
image_path="${image_base}-UHD.jpg"

if ! valid_jpeg "$image_path"; then
  partial=$(mktemp "$CACHE_DIR/.download.XXXXXX")

  if download_image "$image_url" "$partial" 2>/dev/null && valid_jpeg "$partial"; then
    mv -T -- "$partial" "$image_path"
  else
    image_url=$fallback_image_url
    image_path="${image_base}-1920x1080.jpg"
    if ! valid_jpeg "$image_path"; then
      download_image "$image_url" "$partial" \
        || fail "could not download the selected Bing wallpaper in UHD or 1920x1080"
      valid_jpeg "$partial" || fail "Bing returned a file that is not a JPEG image"
      mv -T -- "$partial" "$image_path"
    fi
  fi
fi

changed_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
result=$(jq -c \
  --arg provider "$PROVIDER" \
  --arg market "$MARKET" \
  --arg startDate "$start_date" \
  --arg imageUrl "$image_url" \
  --arg path "$image_path" \
  --arg changedAt "$changed_at" \
  --argjson applied "$APPLY" '
    {
      version: 1,
      provider: $provider,
      market: $market,
      startDate: $startDate,
      urlbase: .urlbase,
      title: .title,
      copyright: .copyright,
      copyrightLink: .copyrightLink,
      imageUrl: $imageUrl,
      path: $path,
      changedAt: $changedAt,
      applied: ($applied == 1)
    }
  ' <<<"$selected")

if (( APPLY )); then
  # Build every state update before changing the desktop, so a failure leaves
  # both the background and the saved state untouched.
  next_recent=$(jq_inputs "input as \$result | input as \$recent
    | [\$result] + \$recent | $RECENT_COLLAPSE | .[:8] | $FIT_STATE" "$result" "$recent")
  next_history=$(jq_inputs "input as \$result | input as \$previous
    | ([\$result.urlbase] + [\$previous[] | select(. != \$result.urlbase)])[:16] | $FIT_STATE
  " "$result" "$history")

  stage_state "$RECENT_FILE" "$next_recent"
  stage_state "$CURRENT_FILE" "$result"
  stage_state "$HISTORY_FILE" "$next_history"
  omarchy theme bg set "$image_path" 9>&-
  touch -- "$image_path"
  commit_state

  mapfile -d '' -t protected_paths < <(jq -j '.[] | .path + "\u0000"' <<<"$next_recent")
  prune_cache "${protected_paths[@]}"
fi

printf '%s\n' "$result"
