#!/usr/bin/env python3

import os
import shutil
import signal
import subprocess
import sys
import tempfile


def interrupted(signum, frame):
    raise SystemExit(128 + signum)


signal.signal(signal.SIGTERM, interrupted)
signal.signal(signal.SIGHUP, interrupted)
temporary = None
try:
    template = sys.argv[1]
    fd, temporary = tempfile.mkstemp(
        dir=os.path.dirname(template), prefix=os.path.basename(template)
    )
    with os.fdopen(fd, "wb") as output:
        if len(sys.argv) > 2:
            result = subprocess.run(sys.argv[2:], stdout=output)
            if result.returncode:
                raise SystemExit(result.returncode)
        else:
            shutil.copyfileobj(sys.stdin.buffer, output)
            output.flush()

        opened = os.fstat(output.fileno())
        named = os.stat(temporary, follow_symlinks=False)
        if (opened.st_dev, opened.st_ino) != (named.st_dev, named.st_ino):
            raise OSError("temporary file changed while writing")

    print(temporary)
    temporary = None
except OSError as error:
    print(f"fresh-wallpaper: {error}", file=sys.stderr)
    raise SystemExit(1)
finally:
    if temporary is not None:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
